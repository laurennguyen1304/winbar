{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the notch, Settings and command bar windows",
  "windows": [
    "notch",
    "notch-*",
    "settings",
    "command-bar"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "drag:default"
  ]
}
